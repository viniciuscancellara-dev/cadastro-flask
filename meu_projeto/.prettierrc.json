
{
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "es5",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "singleAttributePerLine": false,
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "tabWidth": 4,
                "singleQuote": false,
                "printWidth": 120,
                "htmlWhitespaceSensitivity": "css"
            }
        },
        {
            "files": "*.css",
            "options": {
                "tabWidth": 4,
                "singleQuote": false,
                "printWidth": 100
            }
        },
        {
            "files": "*.js",
            "options": {
                "tabWidth": 4,
                "semi": false,
                "singleQuote": true,
                "printWidth": 100
            }
        }
    ]
}